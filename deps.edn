{:paths ["src" "resources" "config"]

 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        io.pedestal/pedestal.service {:mvn/version "0.7.2"}
        io.pedestal/pedestal.jetty {:mvn/version "0.7.2"}
        io.pedestal/pedestal.error {:mvn/version "0.7.2"}
        
        http-kit/http-kit {:mvn/version "2.8.0"}
        com.stuartsierra/component {:mvn/version "1.1.0"}
        prismatic/schema {:mvn/version "1.4.1"}
        cheshire/cheshire {:mvn/version "6.0.0"}
        io.aviso/pretty {:mvn/version "1.4.4"}
        
        ch.qos.logback/logback-classic {:mvn/version "1.5.18"
                                         :exclusions [org.slf4j/slf4j-api]}
        org.slf4j/jul-to-slf4j {:mvn/version "2.0.17"}
        org.slf4j/jcl-over-slf4j {:mvn/version "2.0.17"}
        org.slf4j/log4j-over-slf4j {:mvn/version "2.0.17"}}

 :aliases
 {;; Development dependencies
  :dev {:extra-paths ["dev"]
        :extra-deps {nubank/state-flow {:mvn/version "5.20.1"}
                     nubank/matcher-combinators {:mvn/version "3.9.1"}
                     org.clojure/tools.namespace {:mvn/version "1.5.0"}
                     org.clojure/java.classpath {:mvn/version "1.1.0"}
                     criterium/criterium {:mvn/version "0.4.6"}}}

  ;; REPL
  :repl {:main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]
         :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                      cider/cider-nrepl {:mvn/version "0.50.2"}}}

  ;; Run the application
  :run {:main-opts ["-m" "basic-microservice-example.server"]}

  ;; Run dev server
  :run-dev {:main-opts ["-m" "basic-microservice-example.server/run-dev"]
            :extra-paths ["dev"]
            :extra-deps {nubank/state-flow {:mvn/version "5.20.1"}
                         nubank/matcher-combinators {:mvn/version "3.9.1"}
                         org.clojure/tools.namespace {:mvn/version "1.5.0"}
                         org.clojure/java.classpath {:mvn/version "1.1.0"}
                         criterium/criterium {:mvn/version "0.4.6"}}}

  ;; Testing
  :test {:extra-paths ["test/unit" "test/integration"]
         :extra-deps {nubank/state-flow {:mvn/version "5.20.1"}
                      nubank/matcher-combinators {:mvn/version "3.9.1"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                              :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  :unit {:extra-paths ["test/unit"]
         :extra-deps {nubank/state-flow {:mvn/version "5.20.1"}
                      nubank/matcher-combinators {:mvn/version "3.9.1"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                              :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  :integration {:extra-paths ["test/integration"]
                :extra-deps {nubank/state-flow {:mvn/version "5.20.1"}
                             nubank/matcher-combinators {:mvn/version "3.9.1"}
                             io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                                     :git/sha "dfb30dd"}}
                :main-opts ["-m" "cognitect.test-runner"]}

  ;; Linting with clojure-lsp
  :clojure-lsp {:extra-deps {com.github.clojure-lsp/clojure-lsp-standalone {:mvn/version "2024.08.05-18.16.00"}}
                :main-opts ["-m" "clojure-lsp.main"]}

  ;; Build tools
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}

  ;; Build uberjar (alias for convenience)
  :uberjar {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
            :ns-default build
            :exec-fn uber}}}
